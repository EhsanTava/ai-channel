{
  "name": "agent-room",
  "private": true,
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-room-alkl/agent-room.git"
  },
  "homepage": "https://www.agent-room.com",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm -ws run test --if-present",
    "test:api": "vitest run --dir api",
    "build": "npm -ws run build --if-present",
    "build:ordered": "npm run build -w packages/shared && npm run build -w packages/upstash-client && npm run build -w packages/room-persistence && npm run build -w apps/web",
    "dev:web": "npm -w apps/web run dev",
    "preview:local": "node --import ./scripts/local-loader.mjs ./scripts/local-preview.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "5.0.4",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1040.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
